# Copy to .env and adjust. Never commit .env.
# All values below are local development defaults (fictitious).

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=purchase
POSTGRES_USER=purchase
POSTGRES_PASSWORD=purchase
POSTGRES_PORT=5432

# --- Published ports (docker compose) ---
BACKEND_PORT=8080
FRONTEND_PORT=4200

# --- Backend ---
# Used when running the back-end outside Docker (./mvnw spring-boot:run); compose points it to the postgres service.
DB_URL=jdbc:postgresql://localhost:5432/purchase
DB_USERNAME=purchase
DB_PASSWORD=purchase
SERVER_PORT=8080
# Flyway locations: schema plus demo seed (default). Use classpath:db/migration alone to skip the seed.
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed
# ecs (structured JSON) or empty for plain text logs
LOG_FORMAT=ecs

# --- Authentication ---
# HS256 signing key, at least 32 characters. Empty: a random key per startup (sessions end when the API restarts).
# Set a long random value outside local development, e.g. the output of: openssl rand -base64 48
JWT_SECRET=
# Token lifetime (ISO-8601 duration)
JWT_TTL=PT15M

# --- Production server only (docker-compose.prod.yml, see docs/deploy.md) ---
# Copy this file to /opt/purchase/.env on the server (chmod 600) and fill in real values there.
# Required there: POSTGRES_PASSWORD (openssl rand -base64 24) and JWT_SECRET; DB_URL and the ports above are not used.
# Commit SHA of the running images; written by deploy.sh on every deploy.
IMAGE_TAG=
# Registry prefix of the images (default ghcr.io/seriikmota/developer-challenge).
# IMAGE_PREFIX=ghcr.io/seriikmota/developer-challenge
# Starts the cloudflared service.
COMPOSE_PROFILES=tunnel
# Token of this project's tunnel (Cloudflare Zero Trust > Networks > Tunnels).
CLOUDFLARE_TUNNEL_TOKEN=