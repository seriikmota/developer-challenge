# Copy to .env and adjust. Never commit .env.
# All values below are local development defaults (fictitious).

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=purchase
POSTGRES_USER=purchase
POSTGRES_PASSWORD=purchase
POSTGRES_PORT=5432

# --- Backend ---
DB_URL=jdbc:postgresql://localhost:5432/purchase
DB_USERNAME=purchase
DB_PASSWORD=purchase
SERVER_PORT=8080
# Flyway locations: schema plus demo seed (default). Use classpath:db/migration alone to skip the seed.
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed
# ecs (structured JSON) or empty for plain text logs
LOG_FORMAT=ecs

# --- Authentication ---
# HS256 signing key, at least 32 characters. Leave empty in local dev to use a random key per startup.
JWT_SECRET=
# Token lifetime (ISO-8601 duration)
JWT_TTL=PT15M
